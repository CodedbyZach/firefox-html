+extern const StubThunk sStubThunks[];
+extern const uint32_t sStubThunksSize;
+}  // namespace xpt::detail::wasm
+
+// Typed pure-wasm vtable slot for (methodIndex, signature), generated into
+// xptdata.cpp by xptcodegen.py; nullptr if the pair was not generated.
+static void* FindStubThunk(uint32_t aMethodIndex, const char* aSig) {
+  using namespace xpt::detail::wasm;
+  const char* params = aSig + 2;
+  size_t count = strlen(params);
+  if (count > 24) {
+    return nullptr;
+  }
+  uint64_t key = (uint64_t(aMethodIndex) << 56) | count;
+  for (size_t i = 0; i < count; i++) {
+    char c = params[i];
+    key |= uint64_t(c == 'i' ? 0 : c == 'j' ? 1 : c == 'f' ? 2 : 3) << (6 + 2 * i);
+  }
+  uint32_t lo = 0, hi = sStubThunksSize;
+  while (lo < hi) {
+    uint32_t mid = (lo + hi) / 2;
+    if (sStubThunks[mid].mKey < key) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  return lo < sStubThunksSize && sStubThunks[lo].mKey == key
+             ? sStubThunks[lo].mFn
+             : nullptr;
+}
